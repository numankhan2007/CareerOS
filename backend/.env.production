# ── Production Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# NEVER commit a file with real secrets.

# Supabase PostgreSQL connection string (Session mode, port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host]:5432/postgres

# 64-character random hex string for JWT signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-64-char-random-string-here

# JWT signing algorithm — do not change unless you have a reason.
ALGORITHM=HS256

# The exact URL of your deployed Vercel frontend (no trailing slash).
# This is used by CORS and cookie domain settings.
FRONTEND_ORIGIN=https://your-careeros.vercel.app

# Set to "production" on Render so cookies use Secure + SameSite=None.
# In local development this defaults to "development".
ENVIRONMENT=production
